# ---------------------------------------------------------------------------
# PM-INTERNATIONAL — пример конфигурации. Скопируйте в .env и заполните.
# В ЭТОМ ФАЙЛЕ НЕ ДОЛЖНО БЫТЬ НАСТОЯЩИХ СЕКРЕТОВ. .env в .gitignore.
# ---------------------------------------------------------------------------

APP_ENV=local
LOG_LEVEL=INFO

# База данных. SQLite по умолчанию; для PostgreSQL:
# DATABASE_URL=postgresql+psycopg://pm:pm@db:5432/pm
DATABASE_URL=sqlite:///./data/pm.db

# --- Источник рыночных данных ----------------------------------------------
# mock       — демо-матчи, работает без сети
# polymarket — публичное read-only API Polymarket (ключи НЕ требуются)
MARKET_DATA_PROVIDER=mock
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_TIMEOUT_SECONDS=15
# Фильтр по названию: пусто/Dota — все матчи Dota 2.
# «The International» — только рынки TI.
POLYMARKET_SEARCH_QUERY=Dota
# Тег Dota 2 в Gamma API. Если Polymarket когда-нибудь сменит тег, поиск
# перестанет находить матчи — поменяйте здесь, код трогать не нужно.
POLYMARKET_GAMMA_TAG_ID=102366
POLYMARKET_EVENT_LIMIT=100
# true  — только основной рынок серии (победитель матча)
# false — плюс карты, форы и тоталы (у одного матча ~20-30 рынков)
POLYMARKET_MAIN_MARKET_ONLY=true
# true — скрывать матчи, которые уже начались
POLYMARKET_ONLY_UPCOMING=true

# --- Участник Codex ---------------------------------------------------------
# api — через OPENAI_API_KEY (платится по токенам). Без ключа Codex работает
#       заглушкой, и demo-режим проходит целиком — поэтому это значение
#       по умолчанию.
# cli — через локальный бинарь `codex` (расход по подписке ChatGPT).
#       Ставится отдельно: npm install -g @openai/codex && codex login.
#       Если бинаря нет, Codex будет отклоняться в КАЖДОМ раунде, поэтому
#       переключайте только после установки — см. RUNBOOK, раздел 2.
CODEX_TRANSPORT=api
CODEX_CLI_COMMAND=codex exec --skip-git-repo-check
CODEX_CLI_TIMEOUT_SECONDS=180
CODEX_CLI_MODEL_LABEL=codex-cli

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Участник Claude --------------------------------------------------------
# api — через ANTHROPIC_API_KEY (платится по токенам). Без ключа Claude
#       работает заглушкой — поэтому это значение по умолчанию: demo
#       проходит целиком на голой машине.
# cli — через локальный бинарь `claude` (расход по подписке).
#       Требует установленного и один раз авторизованного CLI.
#       Если бинаря нет, Claude будет отклоняться в КАЖДОМ раунде.
CLAUDE_TRANSPORT=api
CLAUDE_CLI_COMMAND=claude -p
CLAUDE_CLI_TIMEOUT_SECONDS=180
CLAUDE_CLI_MODEL_LABEL=claude-cli

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Боевая конфигурация на сервере -----------------------------------------
# Оба участника работают по подписке, API-ключи не нужны вообще:
#   CODEX_TRANSPORT=cli
#   CLAUDE_TRANSPORT=cli
# Перед этим на сервере надо один раз войти в оба CLI руками (интерактивно)
# и проверить готовность: GET /api/doctor должен показать available: true
# для обоих. Значения по умолчанию выше оставлены на api сознательно —
# чтобы проект запускался на машине, где ни один CLI не установлен.

PARTICIPANT_TIMEOUT_SECONDS=60
PARTICIPANT_MAX_RETRIES=2

# --- Telegram ---------------------------------------------------------------
# Токен от @BotFather. CHAT_ID — куда слать: ваш личный id, id группы
# (отрицательное число) или @имя_канала. Узнать свой id: напишите боту
# и откройте https://api.telegram.org/bot<ТОКЕН>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_SECONDS=15

# --- Доступ к панели --------------------------------------------------------
# Пока PANEL_PASSWORD пуст, панель открыта без авторизации — это допустимо
# только на localhost. Как только пробрасываете наружу для Титана — задайте.
PANEL_USER=operator
PANEL_PASSWORD=
# Отдельный токен для страницы Титана: он получает ссылку с ?t=<токен>
# и не может открыть операторские страницы. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
TITAN_ACCESS_TOKEN=
# Адрес, который подставляется в ссылки Telegram
PUBLIC_BASE_URL=http://localhost:8000

# --- Автоматический планировщик раундов -------------------------------------
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=300
SCHEDULER_OPEN_BEFORE_MATCH_MINUTES=240   # за сколько до матча открывать раунд
SCHEDULER_MIN_BEFORE_MATCH_MINUTES=20     # ближе этого к матчу раунд не открываем
SCHEDULER_MAX_OPEN_ROUNDS=3
SCHEDULER_MARKET_QUERY=Dota
# Что делать, если Титан не успел подать решение:
#   cancel — отменить раунд (по умолчанию; статистика Титана не портится)
#   hold   — записать за него HOLD и исполнить раунд
TITAN_TIMEOUT_POLICY=cancel
TITAN_DEADLINE_MINUTES=15

# --- Банки ------------------------------------------------------------------
INITIAL_BANKROLL_USDC=1000

# --- Risk engine (безопасные значения по умолчанию) -------------------------
RISK_MAX_POSITION_PCT=0.10        # максимум на одну позицию, доля банка
RISK_MAX_MATCH_PCT=0.25           # максимум на один матч
RISK_MAX_TOTAL_EXPOSURE_PCT=0.50  # максимум одновременно в открытых позициях
RISK_MIN_STAKE_USDC=1.0
RISK_MIN_LIQUIDITY_USDC=50.0      # минимальная ликвидность в стакане
RISK_MAX_SLIPPAGE_BPS=300         # 3%
RISK_SNAPSHOT_TTL_SECONDS=900     # snapshot старше — устаревший

# --- Paper execution --------------------------------------------------------
PAPER_FEE_BPS=0                   # комиссия в базисных пунктах от оборота
PAPER_ALLOW_PARTIAL_FILL=true

# --- Экспорт ----------------------------------------------------------------
EXPORT_DIR=./exports

# --- Live trading -----------------------------------------------------------
# ЗАБЛОКИРОВАНО НА УРОВНЕ КОДА. Значение игнорируется, live-исполнения нет.
LIVE_TRADING_ENABLED=false
