# ---------------------------------------------------------------------------
# PM-INTERNATIONAL — пример конфигурации. Скопируйте в .env и заполните.
# В ЭТОМ ФАЙЛЕ НЕ ДОЛЖНО БЫТЬ НАСТОЯЩИХ СЕКРЕТОВ. .env в .gitignore.
# ---------------------------------------------------------------------------

APP_ENV=local
LOG_LEVEL=INFO

# База данных. SQLite по умолчанию; для PostgreSQL:
# DATABASE_URL=postgresql+psycopg://pm:pm@db:5432/pm
DATABASE_URL=sqlite:///./data/pm.db

# --- Источник рыночных данных ----------------------------------------------
# mock       — демо-матчи, работает без сети (по умолчанию)
# polymarket — публичное read-only API Polymarket (ключи НЕ требуются)
MARKET_DATA_PROVIDER=mock
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_TIMEOUT_SECONDS=15
POLYMARKET_SEARCH_QUERY=Dota

# --- Участники --------------------------------------------------------------
# Без ключей адаптеры автоматически работают в mock-режиме.
# Ключи читаются ТОЛЬКО из окружения и никогда не сохраняются в БД/логи.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-5
ANTHROPIC_BASE_URL=https://api.anthropic.com

PARTICIPANT_TIMEOUT_SECONDS=60
PARTICIPANT_MAX_RETRIES=2

# --- Банки ------------------------------------------------------------------
INITIAL_BANKROLL_USDC=1000

# --- Risk engine (безопасные значения по умолчанию) -------------------------
RISK_MAX_POSITION_PCT=0.10        # максимум на одну позицию, доля банка
RISK_MAX_MATCH_PCT=0.25           # максимум на один матч
RISK_MAX_TOTAL_EXPOSURE_PCT=0.50  # максимум одновременно в открытых позициях
RISK_MIN_STAKE_USDC=1.0
RISK_MIN_LIQUIDITY_USDC=50.0      # минимальная ликвидность в стакане
RISK_MAX_SLIPPAGE_BPS=300         # 3%
RISK_SNAPSHOT_TTL_SECONDS=900     # snapshot старше — устаревший

# --- Paper execution --------------------------------------------------------
PAPER_FEE_BPS=0                   # комиссия в базисных пунктах от оборота
PAPER_ALLOW_PARTIAL_FILL=true

# --- Экспорт ----------------------------------------------------------------
EXPORT_DIR=./exports

# --- Live trading -----------------------------------------------------------
# ЗАБЛОКИРОВАНО НА УРОВНЕ КОДА. Значение игнорируется, live-исполнения нет.
LIVE_TRADING_ENABLED=false
